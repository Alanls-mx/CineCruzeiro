datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Multi-tenant: Company
// -----------------------------------------------------------------------------
model Company {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  instances          WhatsAppInstance[]
  contacts           Contact[]
  conversations      Conversation[]
  messages           Message[]
  processedEvents    ProcessedEvent[]
  settings           WhatsAppSettings?
  movies             Movie[]
  rooms              Room[]
  sessions           Session[]
  products           Product[]
  orders             Order[]
  automationFlows    AutomationFlow[]

  @@map("companies")
}

// -----------------------------------------------------------------------------
// WhatsApp Instances
// -----------------------------------------------------------------------------
enum WhatsAppProviderType {
  EVOLUTION
  MOCK
  TWILIO
  META
}

enum WhatsAppInstanceStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

model WhatsAppInstance {
  id             String                 @id @default(uuid())
  companyId      String                 @map("company_id")
  instanceName   String                 @unique @map("instance_name")
  phoneNumber    String?                @map("phone_number")
  status         WhatsAppInstanceStatus @default(DISCONNECTED)
  provider       WhatsAppProviderType   @default(EVOLUTION)
  apiKey         String?                @map("api_key")
  webhookUrl     String?                @map("webhook_url")
  connectedAt    DateTime?              @map("connected_at")
  disconnectedAt DateTime?              @map("disconnected_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("whatsapp_instances")
}

// -----------------------------------------------------------------------------
// Webhook Idempotency
// -----------------------------------------------------------------------------
model ProcessedEvent {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  provider    String
  eventId     String   @map("event_id")
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, eventId])
  @@index([companyId, processedAt])
  @@map("processed_events")
}

// -----------------------------------------------------------------------------
// Contacts
// -----------------------------------------------------------------------------
model Contact {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  phone          String
  name           String?
  profilePicture String?   @map("profile_picture")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  orders        Order[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@map("contacts")
}

// -----------------------------------------------------------------------------
// Conversations
// -----------------------------------------------------------------------------
enum ConversationStatus {
  OPEN
  CLOSED
  WAITING
}

enum ConversationMode {
  BOT
  HUMAN
  PAUSED
}

model Conversation {
  id            String             @id @default(uuid())
  companyId     String             @map("company_id")
  contactId     String             @map("contact_id")
  status        ConversationStatus @default(OPEN)
  mode          ConversationMode   @default(BOT)
  currentFlow   String?            @default("MAIN_MENU") @map("current_flow")
  currentState  String?            @default("INITIAL") @map("current_state")
  context       Json?              @default("{}")
  unreadCount   Int                @default(0) @map("unread_count")
  fallbackCount Int                @default(0) @map("fallback_count")
  startedAt     DateTime           @default(now()) @map("started_at")
  lastMessageAt DateTime           @default(now()) @map("last_message_at")
  closedAt      DateTime?          @map("closed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact             Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages            Message[]
  orders              Order[]
  automationExecutions AutomationExecution[]

  @@index([companyId, status])
  @@index([companyId, contactId])
  @@index([companyId, lastMessageAt])
  @@map("conversations")
}

// -----------------------------------------------------------------------------
// Messages
// -----------------------------------------------------------------------------
enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  BUTTON
  LIST
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  CONTACT
  UNKNOWN
}

enum MessageSender {
  CUSTOMER
  BOT
  AGENT
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                String           @id @default(uuid())
  companyId         String           @map("company_id")
  conversationId    String           @map("conversation_id")
  externalMessageId String?          @map("external_message_id")
  direction         MessageDirection
  type              MessageType      @default(TEXT)
  sender            MessageSender
  content           String           @db.Text
  metadata          Json?            @default("{}")
  status            MessageStatus    @default(SENT)
  createdAt         DateTime         @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([companyId, conversationId, createdAt])
  @@index([companyId, externalMessageId])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// Bot & WhatsApp Settings
// -----------------------------------------------------------------------------
model WhatsAppSettings {
  id                   String   @id @default(uuid())
  companyId            String   @unique @map("company_id")
  autoReplyEnabled     Boolean  @default(true) @map("auto_reply_enabled")
  welcomeMessage       String   @default("Olá! 👋 Bem-vindo ao {cinema_name}. Como podemos ajudar hoje?") @map("welcome_message")
  fallbackMessage      String   @default("Desculpe, não consegui entender. Por favor, escolha uma das opções abaixo:") @map("fallback_message")
  outOfHoursMessage    String   @default("Nosso atendimento humano está fechado no momento, mas você pode consultar programação e ingressos normalmente pelo menu!") @map("out_of_hours_message")
  workingHours         Json     @default("{\"monday\":{\"start\":\"13:00\",\"end\":\"22:00\",\"enabled\":true},\"tuesday\":{\"start\":\"13:00\",\"end\":\"22:00\",\"enabled\":true},\"wednesday\":{\"start\":\"13:00\",\"end\":\"22:00\",\"enabled\":true},\"thursday\":{\"start\":\"13:00\",\"end\":\"22:00\",\"enabled\":true},\"friday\":{\"start\":\"13:00\",\"end\":\"23:00\",\"enabled\":true},\"saturday\":{\"start\":\"13:00\",\"end\":\"23:00\",\"enabled\":true},\"sunday\":{\"start\":\"13:00\",\"end\":\"22:00\",\"enabled\":true}}") @map("working_hours")
  autoCloseMinutes     Int      @default(60) @map("auto_close_minutes")
  debounceDelayMs      Int      @default(3000) @map("debounce_delay_ms")
  humanSupportEnabled  Boolean  @default(true) @map("human_support_enabled")
  showProgramming      Boolean  @default(true) @map("show_programming")
  showTickets          Boolean  @default(true) @map("show_tickets")
  showSnackBar         Boolean  @default(true) @map("show_snack_bar")
  maxFallbackCount     Int      @default(3) @map("max_fallback_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

// -----------------------------------------------------------------------------
// Cinema Domain: Movies, Rooms, Sessions, Products, Orders
// -----------------------------------------------------------------------------
enum MovieRating {
  L
  AGE_10
  AGE_12
  AGE_14
  AGE_16
  AGE_18
}

model Movie {
  id              String      @id @default(uuid())
  companyId       String      @map("company_id")
  title           String
  description     String      @db.Text
  posterUrl       String?     @map("poster_url")
  durationMinutes Int         @map("duration_minutes")
  rating          MovieRating @default(L)
  genre           String
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([companyId, isActive])
  @@map("movies")
}

enum RoomType {
  STANDARD
  VIP
  D3D
  IMAX
}

model Room {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  capacity  Int
  type      RoomType @default(STANDARD)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([companyId])
  @@map("rooms")
}

enum AudioType {
  DUBBED
  SUBTITLED
  NATIONAL
}

enum SessionFormat {
  D2D
  D3D
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Session {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  movieId        String        @map("movie_id")
  roomId         String        @map("room_id")
  startTime      DateTime      @map("start_time")
  endTime        DateTime      @map("end_time")
  audioType      AudioType     @default(DUBBED) @map("audio_type")
  format         SessionFormat @default(D2D)
  price          Decimal       @db.Decimal(10, 2)
  availableSeats Int           @map("available_seats")
  status         SessionStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([companyId, startTime])
  @@index([companyId, movieId])
  @@map("sessions")
}

enum ProductCategory {
  POPCORN
  BEVERAGE
  COMBO
  CANDY
  SNACK
}

model Product {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  name        String
  description String          @db.Text
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String?         @map("image_url")
  isAvailable Boolean         @default(true) @map("is_available")
  stock       Int             @default(100)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([companyId, category, isAvailable])
  @@map("products")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

model Order {
  id             String      @id @default(uuid())
  companyId      String      @map("company_id")
  contactId      String      @map("contact_id")
  conversationId String?     @map("conversation_id")
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  checkoutToken  String      @unique @map("checkout_token")
  expiresAt      DateTime    @map("expires_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  tickets      Ticket[]
  items        OrderItem[]

  @@index([companyId, checkoutToken])
  @@index([companyId, contactId])
  @@map("orders")
}

enum TicketType {
  FULL
  HALF
}

model Ticket {
  id         String     @id @default(uuid())
  orderId    String     @map("order_id")
  sessionId  String     @map("session_id")
  seatNumber String     @map("seat_number")
  type       TicketType @default(FULL)
  price      Decimal    @db.Decimal(10, 2)
  createdAt  DateTime   @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// -----------------------------------------------------------------------------
// Visual Automation & Extensibility Foundation
// -----------------------------------------------------------------------------
enum AutomationTriggerType {
  NEW_MESSAGE
  KEYWORD
  OUT_OF_HOURS
  TIMEOUT
}

model AutomationFlow {
  id          String                @id @default(uuid())
  companyId   String                @map("company_id")
  name        String
  description String?
  triggerType AutomationTriggerType @default(NEW_MESSAGE) @map("trigger_type")
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nodes      AutomationNode[]
  edges      AutomationEdge[]
  executions AutomationExecution[]

  @@index([companyId, isActive])
  @@map("automation_flows")
}

enum AutomationNodeType {
  TRIGGER
  SEND_TEXT
  SEND_BUTTONS
  SEND_LIST
  CONDITION
  WAIT
  DATABASE_QUERY
  SET_STATE
  TRANSFER_TO_HUMAN
  WEBHOOK
  HTTP_REQUEST
}

model AutomationNode {
  id        String             @id @default(uuid())
  flowId    String             @map("flow_id")
  type      AutomationNodeType
  label     String
  config    Json               @default("{}")
  positionX Float              @default(0) @map("position_x")
  positionY Float              @default(0) @map("position_y")
  createdAt DateTime           @default(now()) @map("created_at")

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@map("automation_nodes")
}

model AutomationEdge {
  id           String   @id @default(uuid())
  flowId       String   @map("flow_id")
  sourceNodeId String   @map("source_node_id")
  targetNodeId String   @map("target_node_id")
  sourceHandle String?  @map("source_handle")
  targetHandle String?  @map("target_handle")
  condition    Json?
  createdAt    DateTime @default(now()) @map("created_at")

  flow AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId])
  @@map("automation_edges")
}

enum ExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  WAITING
}

model AutomationExecution {
  id             String          @id @default(uuid())
  flowId         String          @map("flow_id")
  conversationId String          @map("conversation_id")
  status         ExecutionStatus @default(RUNNING)
  currentNodeId  String?         @map("current_node_id")
  logs           Json?           @default("[]")
  startedAt      DateTime        @default(now()) @map("started_at")
  completedAt    DateTime?       @map("completed_at")

  flow         AutomationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([flowId, status])
  @@index([conversationId])
  @@map("automation_executions")
}
