# ==============================================================================
# LumixEngine WhatsApp - Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3333
HOST=127.0.0.1
APP_URL=http://localhost:3333
EVOLUTION_WEBHOOK_URL=https://lumixengine.com/projects/cinecruzeiro/whatsapp/webhook

# Lumix PostgreSQL
LUMIX_DB_USER=lumix
LUMIX_DB_PASSWORD=lumix_secure_password
LUMIX_DB_NAME=lumix_whatsapp
LUMIX_DB_PORT=5432
DATABASE_URL=postgresql://lumix:lumix_secure_password@localhost:5432/lumix_whatsapp?schema=public

# Evolution PostgreSQL (Isolated)
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution_secure_password
EVOLUTION_DB_NAME=evolution
EVOLUTION_DB_PORT=5433
EVOLUTION_DATABASE_URL=postgresql://evolution:evolution_secure_password@postgres-evolution:5432/evolution?schema=public

# Redis & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Evolution API Configuration
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change_me_with_a_unique_evolution_key
EVOLUTION_WEBHOOK_SECRET=change_me_with_a_unique_32_character_webhook_secret

# Security & CORS
JWT_SECRET=change_me_with_a_unique_32_character_secret
INTERNAL_API_TOKEN=change_me_with_a_unique_32_character_internal_token
CINE_COMPANY_SLUG=cine-cruzeiro
CORS_ORIGIN=https://lumixengine.com

# WhatsApp Flow Engine & Debounce
DEFAULT_DEBOUNCE_DELAY_MS=3000
CONVERSATION_LOCK_TTL_SECONDS=15
CHECKOUT_BASE_URL=https://lumixengine.com/projects/cinecruzeiro

# Cine Cruzeiro commercial catalog (obtain the token in Admin > Integrações)
COMMERCIAL_CATALOG_URL=https://lumixengine.com/projects/cinecruzeiro/api/commercial/catalog
COMMERCIAL_CATALOG_TOKEN=change_me_with_the_catalog_token
COMMERCIAL_CATALOG_CACHE_TTL_SECONDS=60
