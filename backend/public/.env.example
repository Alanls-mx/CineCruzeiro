# Use uma das duas formas de autenticacao do TMDB.
# Recomendado: token Bearer v4 gerado na area de API do TMDB.
TMDB_BEARER_TOKEN=seu_token_tmdb

# Alternativa: API key v3.
TMDB_API_KEY=sua_api_key_tmdb

# Checkout Transparente e Webhooks do Mercado Pago.
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET_SANDBOX=
MERCADO_PAGO_WEBHOOK_SECRET_PRODUCTION=

# O painel do simulador exige login de proprietário e pode ser desligado.
WEBHOOK_TESTER_ENABLED=true

# Retenção automática dos logs operacionais persistidos no PostgreSQL.
SYSTEM_LOG_RETENTION_DAYS=90

# Assinatura criptografica dos QR Codes. Em producao, mantenha os PEM fora das releases.
TICKET_QR_PRIVATE_KEY_FILE=/caminho/persistente/ticket-qr-private.pem
TICKET_QR_PUBLIC_KEY_FILE=/caminho/persistente/ticket-qr-public.pem
TICKET_QR_KEY_ID=cine-cruzeiro-2026
