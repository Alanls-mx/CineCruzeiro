N8N_HOST=automation.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_USER_MANAGEMENT_JWT_SECRET=replace-with-a-different-long-random-value
N8N_RUNNERS_AUTH_TOKEN=replace-with-a-third-long-random-value
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-password
STUDIO_BASE_URL=https://example.com/projects/cinema
STUDIO_AUTOMATION_TOKEN=use-the-same-secret-configured-in-the-studio
GENERIC_TIMEZONE=America/Sao_Paulo
