{
  "id": "estacaoCineEmailMovieEvent",
  "name": "Cine Estação | E-mail - Estreias e eventos de filme",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none"
  },
  "nodes": [
    {
      "id": "schedule",
      "name": "Diariamente às 9h30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -90
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "trigger",
      "name": "Filme publicado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        90
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cine-estacao/email/movie-published",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "prepare",
      "name": "Normalizar estreia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const event=$input.first().json.body||$input.first().json||{}; return [{json:{type:'premiere',...(event.movieId?{movieId:String(event.movieId)}:{}),triggerType:event.type||'schedule.daily'}}];"
      }
    },
    {
      "id": "campaign",
      "name": "Preparar estreia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ESTACAO_EMAIL_AUTOMATION_BASE_URL + '/api/email-automation/campaigns' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.ESTACAO_EMAIL_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Diariamente às 9h30": {
      "main": [
        [
          {
            "node": "Normalizar estreia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filme publicado": {
      "main": [
        [
          {
            "node": "Normalizar estreia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar estreia": {
      "main": [
        [
          {
            "node": "Preparar estreia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
